# --- Database ---
DATABASE_URL=mysql+pymysql://utender:utender@localhost:3306/utender

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# --- File storage: local (default) or s3 ---
# Switching backends is config-only — no code change.
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
STORAGE_SIGNING_SECRET=change-me-to-a-different-long-random-string

# Only used when STORAGE_BACKEND=s3
S3_BUCKET_DRAWINGS=project-drawings
S3_BUCKET_DOCUMENTS=service-provider-documents
S3_BUCKET_OWNER_DOCUMENTS=owner-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_OBJECT_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_DEFAULT_EXPIRY_SECONDS=86400

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=U-Tender <notifications@u-tender.example>

# --- Deadline-reminder cron ---
CRON_SECRET=change-me-to-a-random-string

# --- Environment ---
# "production" makes the app refuse to start while JWT_SECRET or
# STORAGE_SIGNING_SECRET is still a placeholder, or APP_URL / API_URL /
# CORS_ORIGINS point at localhost; it warns at every start while DATABASE_URL
# uses the development credentials or the site isn't served over https
# (cookies not Secure), and hides /docs and /openapi.json. The deploy scripts set it.
ENVIRONMENT=development
# Secure flag on the login cookies. Unset follows APP_URL (https => Secure);
# set COOKIE_SECURE=true if TLS terminates in front of an http APP_URL.
# COOKIE_SECURE=true

# --- URLs ---
APP_URL=http://localhost:5173
API_URL=http://localhost:8000

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:5173

# --- Request limits ---
# Rejected before the body is read into memory (Content-Length check).
MAX_UPLOAD_MB=50
